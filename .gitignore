# ============================================
# S32DS / Eclipse 工程 Git 忽略规则
# 适用于 S32K144 最小系统空白模板
# ============================================

# ---- 编译产物目录 ----
Debug_FLASH/
Debug_APP/
Debug_RAM/
_build_app/
_build_boot/

# ---- 编译生成的中间文件 ----
*.o
*.obj
*.elf
*.map
*.siz
*.d
*.su
*.lst

# ---- 自动生成的 IDE 配置 ----
Debug_Configurations/
.settings/
.cproject.bak
.project.bak
description.txt

# ---- 自动生成的 SDK 配置（由 S32DS 自动生成） ----
SDK/

# ---- 生成的文档目录 ----
Doxygen/

# ---- MATLAB/Simulink 缓存 ----
*.mex
*.slxc
*.autosave

# ---- 操作系统/编辑器临时文件 ----
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- 备份文件 ----
*.bak
*.orig

# ---- 以下文件虽然是编译产物，但需要提交 ----
# （app_a.bin / app_b.bin 是 CANoe 刷写时按槽位选择的固件镜像）
!app_a.bin
!app_b.bin
