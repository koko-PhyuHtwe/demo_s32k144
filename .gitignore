# ============================================
# S32DS / Eclipse 工程 Git 忽略规则
# 适用于 S32K144 最小系统空白模板
# ============================================

# ---- 编译产物目录 ----
Boot_*/
APP_*/

# ---- 编译生成的中间文件 ----
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.siz
*.d
*.su
*.lst
*.cbf

# ---- 自动生成的 IDE 配置 ----
Debug_Configurations/
.settings/
.cproject.bak
.project.bak
description.txt

# ---- 自动生成的 SDK 配置（由 S32DS 自动生成） ----
SDK/

# ---- 生成的文档目录 ----
Doxygen/

# ---- MATLAB/Simulink 缓存 ----
*.mex
*.slxc
*.autosave

# ---- 操作系统/编辑器临时文件 ----
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- 备份文件 ----
*.bak
*.orig

